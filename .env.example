# ==============================================================================
# DATABASE
# ==============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/gym_management?schema=public"

# ==============================================================================
# AUTH / SESSION
# ==============================================================================
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret"

# Bootstrap credentials for the very first Super Admin (see prisma/seed.ts).
SEED_SUPER_ADMIN_EMAIL="owner@yourgym.com"
SEED_SUPER_ADMIN_PASSWORD="change-me-immediately"

# ==============================================================================
# CLOUDINARY (member photos + generated invoice PDFs)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ==============================================================================
# RAZORPAY PAYMENT GATEWAY (Online Member Self-Renewal)
# ==============================================================================
# Get keys from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ==============================================================================
# EMAIL NOTIFICATIONS (SMTP / Nodemailer)
# ==============================================================================
# Works with Gmail, SendGrid, Amazon SES, Brevo, Mailgun, or custom SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Gym Notifications <no-reply@yourgym.com>"
SMTP_SECURE="false"

# ==============================================================================
# META WHATSAPP BUSINESS CLOUD API (Optional - kept intact)
# ==============================================================================
# From Meta Business Manager > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Approved template names — must match exactly what's approved in Meta Business Manager
WA_TEMPLATE_DUE_REMINDER="payment_due_reminder"
WA_TEMPLATE_PAYMENT_CONFIRMATION="payment_confirmation"

# Webhook verify token for app/api/webhooks/whatsapp (delivery status callbacks)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# ==============================================================================
# CRON
# ==============================================================================
# Set the SAME value in Vercel Project Settings > Cron Jobs (auto-injected
# as the Authorization header) OR pass manually if self-hosting with node-cron.
CRON_SECRET="replace-with-a-long-random-secret"

# Only needed by scripts/cron-due-reminders.ts (non-Vercel hosting)
APP_BASE_URL="https://a3fitness-gms.vercel.app"
CRON_TIMEZONE="Asia/Kolkata"

# ==============================================================================
# RATE LIMITING (optional but recommended for production)
# ==============================================================================
# Powers lib/rate-limit.ts. If left blank, falls back to an in-memory limiter
# that works for local dev / a single server but NOT across multiple
# serverless instances (e.g. Vercel). Get free credentials at upstash.com.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ==============================================================================
# APP
# ==============================================================================
NODE_ENV="development"
